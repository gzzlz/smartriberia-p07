# SmartRiberIA - valores comunes a los 3 grupos (NO cambiar entre grupos)
# Cambiar algo aquí obliga a etiquetar una versión nueva del repositorio.

# Imagen base fijada (build con fecha, nunca "latest")
DEBIAN_BUILD=20261103-2651
IMAGEN="debian-13-generic-amd64-${DEBIAN_BUILD}.qcow2"
IMAGEN_URL="https://cloud.debian.org/images/cloud/trixie/${DEBIAN_BUILD}"

# Recursos por VM (enunciado P07, sesión 1)
VCPU=8
RAM_MB=24576
DISCO_GB=100

# Red del aula (comprobada en riberaws02 el 2026-11-06)
# El host usa /16, pero el router solo encamina y hace NAT para 172.30.101.0/24:
# todas las VMs van en 172.30.101.x (probado: .201.11 sin salida, .101.211 con salida)
RED_PREFIJO=172.30.101
PREFIJO_LEN=16
GATEWAY=172.30.101.1
DNS=8.8.8.8
NTP=ntp.ubuntu.com

# Red de gestión host <-> su propia VM (aislada, no sale del PC)
MGMT_RED=rke2-mgmt
MGMT_BRIDGE=virbr-rke2mgt
MGMT_PREFIJO=192.168.200
MGMT_HOST_IP=192.168.200.1     # IP de la VM: ${MGMT_PREFIJO}.(10+X), única en el grupo
MGMT_LEN=24

# Usuario de las VMs
USUARIO_VM=iabd
ZONA_HORARIA=Europe/Madrid

# Puestos: nombre -> X. IP aula = RED_PREFIJO.(IP_BASE+X); MAC termina en 0X
PUESTOS="cp1:1 cp2:2 cp3:3 w1:4 w2:5 w3:6"

# --- Hito 02: RKE2 -------------------------------------------------------------
# Versión fijada (canal "stable" consultado el 2026-11-10 desde g1-cp1)
RKE2_VERSION="v1.36.6+rke2r1"
RKE2_URL="https://github.com/rancher/rke2/releases/download/${RKE2_VERSION//+/%2B}"
RKE2_INSTALL_URL="https://raw.githubusercontent.com/rancher/rke2/${RKE2_VERSION}/install.sh"
# Artefactos air-gap para Cilium (core + cilium), binario y sumas
RKE2_ARTEFACTOS="rke2.linux-amd64.tar.gz rke2-images-core.linux-amd64.tar.zst rke2-images-cilium.linux-amd64.tar.zst sha256sum-amd64.txt"

# Rol de cada puesto en RKE2: server-init (crea el clúster), server, agent
ROLES="cp1:server-init cp2:server cp3:server w1:agent w2:agent w3:agent"

# Recursos reservados para el sistema y Kubernetes (los servidores también ejecutan cargas)
KUBE_RESERVED="cpu=500m,memory=1Gi"
SYSTEM_RESERVED="cpu=500m,memory=1Gi"
