# SmartRiberIA - valores comunes a los 3 grupos (NO cambiar entre grupos)
# Cambiar algo aquí obliga a etiquetar una versión nueva del repositorio.

# Imagen base fijada (build con fecha, nunca "latest")
DEBIAN_BUILD=20261103-2651
IMAGEN="debian-13-generic-amd64-${DEBIAN_BUILD}.qcow2"
IMAGEN_URL="https://cloud.debian.org/images/cloud/trixie/${DEBIAN_BUILD}"

# Recursos por VM (enunciado P07, sesión 1)
VCPU=8
RAM_MB=24576
DISCO_GB=100

# Red del aula (comprobada en riberaws02 el 2026-11-06)
PREFIJO_LEN=16
GATEWAY=172.30.101.1
DNS=8.8.8.8
NTP=ntp.ubuntu.com

# Red de gestión host <-> su propia VM (aislada, no sale del PC)
MGMT_RED=rke2-mgmt
MGMT_BRIDGE=virbr-rke2mgt
MGMT_HOST_IP=192.168.200.1
MGMT_VM_IP=192.168.200.10
MGMT_LEN=24

# Usuario de las VMs
USUARIO_VM=iabd
ZONA_HORARIA=Europe/Madrid

# Puestos: nombre -> X (el último octeto de la IP es 10+X; la MAC termina en 0X)
PUESTOS="cp1:1 cp2:2 cp3:3 w1:4 w2:5 w3:6"
